<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_dashboard.xml - Ana Sayfa (Dashboard) Fragment Layout
    
    İçerir:
    - Karşılama metni (kullanıcı adı ile)
    - Toplam gezi sayacı
    - RecyclerView (gezi kartları listesi)
    - Boş durum görünümü (liste boşken)
    - FAB (Floating Action Button) - yeni gezi ekle
    - ProgressBar - yükleme göstergesi
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/bg_primary">

    <!-- Üst başlık alanı: AppBarLayout ile kaydırma davranışı -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_primary"
        app:elevation="0dp">

        <!-- Araç çubuğu: Settings butonunu içerir -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Uygulama logosu / başlık -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✈"
                    android:textSize="22sp"
                    android:textColor="@color/accent_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  Traveler"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Ayarlar butonu (sağda) -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                android:tint="@color/text_secondary"
                android:contentDescription="Ayarlar" />

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Kaydırılabilir içerik alanı -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== ÖZLÜ SÖZ ALANI ===== -->
            <TextView
                android:id="@+id/tvQuote"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="italic"
                android:lineSpacingMultiplier="1.5"
                android:alpha="1"
                tools:text="\'Seyahat etmek yaşamaktır.'\ — Hans Christian Andersen"
                android:ellipsize="end"
                android:maxLines="3"/>

            <!-- ===== KARŞILAMA KARTI ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">



                    <!-- Karşılama metni (SharedPreferences'dan gelir) -->
                    <TextView
                        android:id="@+id/tv_welcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Merhaba, Gezgin! 👋"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Yeni maceralar seni bekliyor"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <!-- İstatistik satırı -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <!-- Toplam gezi sayacı -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_trip_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 Gezi"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent_orange" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Toplam"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <!-- Ayraç çizgisi -->
<!--                        <View-->
<!--                            android:layout_width="1dp"-->
<!--                            android:layout_height="40dp"-->
<!--                            android:background="@color/card_stroke" />-->

                        <!-- "Yeni Ekle" hızlı eylem -->
<!--                        <LinearLayout-->
<!--                            android:layout_width="0dp"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:layout_weight="1"-->
<!--                            android:orientation="vertical"-->
<!--                            android:gravity="center">-->

<!--                            <TextView-->
<!--                                android:layout_width="wrap_content"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:text="+"-->
<!--                                android:textSize="22sp"-->
<!--                                android:textStyle="bold"-->
<!--                                android:textColor="@color/accent_orange" />-->

<!--                            <TextView-->
<!--                                android:layout_width="wrap_content"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:text="Yeni Ekle"-->
<!--                                android:textSize="12sp"-->
<!--                                android:textColor="@color/text_secondary" />-->
<!--                        </LinearLayout>-->

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== GEZİLER BAŞLIĞI ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Gezilerim"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <!-- ===== YÜKLENİYOR GÖSTERGESİ ===== -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/accent_orange"
                android:visibility="gone" />

            <!-- ===== BOŞ DURUM GÖRÜNÜMÜ ===== -->
            <!--
                Liste boşken gösterilir. Kullanıcıya rehberlik eder.
                Bu alan "Henüz bir gezi eklenmedi" mesajını gösterir.
            -->
            <LinearLayout
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone">

                <!-- Boş durum ikonu -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗺️"
                    android:textSize="64sp"
                    android:gravity="center" />

                <!-- Boş durum başlığı -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Henüz bir gezi eklenmedi"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center" />

                <!-- Boş durum açıklaması -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Sağ alttaki + butonuna basarak\nilk gezini planlamaya başla!"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

            <!-- ===== GEZİ LİSTESİ (RecyclerView) ===== -->
            <!--
                nestedScrollingEnabled="false": NestedScrollView içinde düzgün scroll için
                Liste dolu olduğunda bu görünür, boş durum gizlenir.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_trips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="100dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== FAB BUTONU ===== -->
    <!--
        Extended FAB: "Gezi Ekle" metni ile birlikte gösterilir.
        CoordinatorLayout içinde Snackbar ile uyumlu çalışır.
        app:layout_behavior ile Snackbar'a göre yukarı kayar.
    -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_trip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:text="Gezi Ekle"
        android:textColor="@color/bg_primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/bg_primary"
        app:backgroundTint="@color/accent_orange"
        app:cornerRadius="16dp"
        app:elevation="8dp" />



</androidx.coordinatorlayout.widget.CoordinatorLayout>
