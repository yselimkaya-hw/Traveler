<?xml version="1.0" encoding="utf-8"?>
<!--
    item_trip_stop.xml
    Rota duraklarını listeleyen RecyclerView'ın her bir satır layout'u.
    TripStopAdapter → TripStopViewHolder tarafından şişirilir.
    ViewBinding etkin: ItemTripStopBinding sınıfı otomatik üretilir.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/stroke_subtle"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Sol renk şeridi: Durak sırasını görsel olarak vurgular -->
        <View
            android:id="@+id/viewAccentBar"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@color/accent_orange"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Sıra etiketi: "1. Durak", "2. Durak" -->
        <TextView
            android:id="@+id/tvStopOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/accent_orange"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            app:layout_constraintStart_toEndOf="@id/viewAccentBar"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1. DURAK" />

        <!-- Durak adı -->
        <TextView
            android:id="@+id/tvStopName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/checkboxVisited"
            app:layout_constraintStart_toStartOf="@id/tvStopOrder"
            app:layout_constraintTop_toBottomOf="@id/tvStopOrder"
            tools:text="Sultanahmet Meydanı" />

        <!-- Durak notları (opsiyonel, boşsa GONE) -->
        <TextView
            android:id="@+id/tvStopNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/checkboxVisited"
            app:layout_constraintStart_toStartOf="@id/tvStopOrder"
            app:layout_constraintTop_toBottomOf="@id/tvStopName"
            tools:text="Tarihi camii ve çevresindeki çarşıları gezin." />

        <!-- Tahmini süre etiketi (opsiyonel, 0 dk ise GONE) -->
<!--        <TextView-->
<!--            android:id="@+id/tvStopDuration"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="8dp"-->
<!--            android:background="@drawable/bg_duration_chip"-->
<!--            android:fontFamily="@font/inter_regular"-->
<!--            android:paddingHorizontal="8dp"-->
<!--            android:paddingVertical="3dp"-->
<!--            android:textColor="@color/accent_orange"-->
<!--            android:textSize="12sp"-->
<!--            app:layout_constraintStart_toStartOf="@id/tvStopOrder"-->
<!--            app:layout_constraintTop_toBottomOf="@id/tvStopNotes"-->
<!--            tools:text="⏱ 90 dk" />-->

        <!-- Ziyaret edildi CheckBox -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkboxVisited"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent_orange"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
