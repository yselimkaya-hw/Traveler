<?xml version="1.0" encoding="utf-8"?>
<!--
    colors.xml - Traveler Uygulaması Renk Paleti
    
    Tasarım Dili: Modern Light Theme Güncellemesi
-->
<resources>

    <!-- ===== ANA ARKA PLAN RENKLERİ ===== -->
    <!-- En parlak katman - fragment arka planı -->
    <color name="bg_primary">#FFFFFF</color>

    <!-- İkincil arka plan - toolbar, bottom bar -->
    <color name="bg_secondary">#F5F5F5</color>

    <!-- Kart ve yüzey rengi -->
    <color name="bg_card">#F0F0F0</color>

    <!-- Yükseltilmiş yüzey - dialog, bottom sheet -->
    <color name="bg_elevated">#E8E8E8</color>

    <!-- ===== VURGU RENKLERİ (DEĞİŞTİRİLMEDİ) ===== -->
    <color name="accent_orange">#FF9F1C</color>
    <color name="accent_orange_dark">#E8870A</color>
    <color name="accent_orange_alpha">#26FF9F1C</color>
    <color name="accent_blue">#4E9AF1</color>
    <color name="accent_green">#2ECC71</color>

    <!-- ===== METİN RENKLERİ ===== -->
    <!-- Birincil metin: Koyu Lacivert/Siyah tonu -->
    <color name="text_primary">#1A1A2E</color>

    <!-- İkincil metin: Soluk gri-mavi -->
    <color name="text_secondary">#555577</color>

    <!-- Placeholder/hint metni -->
    <color name="text_hint">#9999AA</color>

    <!-- Devre dışı metin -->
    <color name="text_disabled">#BBBBCC</color>

    <!-- ===== DURUM RENKLERİ (DEĞİŞTİRİLMEDİ) ===== -->
    <color name="status_success">#2ECC71</color>
    <color name="status_success_alpha">#262ECC71</color>
    <color name="status_warning">#F39C12</color>
    <color name="status_error">#E74C3C</color>
    <color name="status_error_alpha">#26E74C3C</color>
    <color name="status_info">#3498DB</color>

    <!-- ===== UI ELEMANLARI ===== -->
    <!-- Kart kenarlık çizgisi -->
    <color name="card_stroke">#DDDDEE</color>

    <!-- İnce kenarlık -->
    <color name="stroke_subtle">#E0E0EE</color>

    <!-- Divider (ayraç) çizgisi -->
    <color name="divider">#EEEEEE</color>

    <!-- Ripple efekti (tıklama dalgası) -->
    <color name="ripple_color">#33FF9F1C</color>

    <!-- Overlay (üst katman) -->
    <color name="overlay_dark">#99000000</color>

    <!-- ===== MATERYAL TEMA GEREKSİNİMLERİ ===== -->
    <color name="colorPrimary">#FF9F1C</color>
    <color name="colorPrimaryVariant">#E8870A</color>
    <color name="colorOnPrimary">#FFFFFF</color>
    <color name="colorSecondary">#4E9AF1</color>
    <color name="colorOnSecondary">#FFFFFF</color>

    <!-- Güncellenen Materyal Renkleri -->
    <color name="colorBackground">#FFFFFF</color>
    <color name="colorOnBackground">#1A1A2E</color>
    <color name="colorSurface">#F0F0F0</color>
    <color name="colorOnSurface">#1A1A2E</color>

    <color name="colorError">#E74C3C</color>
    <color name="colorOnError">#FFFFFF</color>

</resources>