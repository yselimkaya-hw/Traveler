<?xml version="1.0" encoding="utf-8"?>
<!--
    arrays.xml
    Google Fonts Provider sertifikalarını içerir.
    Inter fontunu Google Fonts API üzerinden indirmek için gereklidir.
    Bu sertifikalar Google Mobile Services (GMS) için standarttır.
-->
<resources>
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>

    <!-- Geliştirme ortamı GMS sertifikası (SHA-256) -->
    <string-array name="com_google_android_gms_fonts_certs_dev">
        <item></item>
    </string-array>

    <!-- Üretim ortamı GMS sertifikası (SHA-256) -->
    <string-array name="com_google_android_gms_fonts_certs_prod">
        <item></item>
    </string-array>

</resources>
