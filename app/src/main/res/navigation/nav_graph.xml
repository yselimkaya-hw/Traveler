<?xml version="1.0" encoding="utf-8"?>
<!--
    nav_graph.xml - Navigation Component Graf Tanımı
    
    Tüm fragment'lar ve aralarındaki geçiş action'ları burada tanımlanır.
    startDestination: Uygulama ilk açıldığında gösterilecek fragment.
    
    Fragment Akışı:
    OnboardingFragment → DashboardFragment ↔ AddTripFragment
                                ↕
                      TripDetailsFragment
                                ↕
                       SettingsFragment
-->
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <!-- ===== ONBOARDING FRAGMENT ===== -->
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.traveler.app.view.fragment.OnboardingFragment"
        android:label="Hoş Geldin"
        tools:layout="@layout/fragment_onboarding">

        <!-- Onboarding tamamlandıktan sonra Dashboard'a geç -->
        <action
            android:id="@+id/action_onboarding_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
        <!--
            popUpTo + popUpToInclusive: Onboarding'i back stack'ten kaldırır.
            Geri tuşuna basıldığında Onboarding'e dönülmez.
        -->

    </fragment>

    <!-- ===== DASHBOARD FRAGMENT ===== -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.traveler.app.view.fragment.DashboardFragment"
        android:label="Gezilerim"
        tools:layout="@layout/fragment_dashboard">

        <!-- Dashboard → Gezi Ekleme -->
        <action
            android:id="@+id/action_dashboard_to_addTrip"
            app:destination="@id/addTripFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <!-- Dashboard → Gezi Detayları (tripId argument ile) -->
        <action
            android:id="@+id/action_dashboard_to_tripDetails"
            app:destination="@id/tripDetailsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <!-- Dashboard → Ayarlar -->
        <action
            android:id="@+id/action_dashboard_to_settings"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <!-- ===== GEZI EKLEME FRAGMENT ===== -->
    <fragment
        android:id="@+id/addTripFragment"
        android:name="com.traveler.app.view.fragment.AddTripFragment"
        android:label="Yeni Gezi"
        tools:layout="@layout/fragment_add_trip" />

    <!-- ===== GEZI DETAY FRAGMENT ===== -->
    <fragment
        android:id="@+id/tripDetailsFragment"
        android:name="com.traveler.app.view.fragment.TripDetailsFragment"
        android:label="Gezi Detayı"
        tools:layout="@layout/fragment_trip_details">

        <!-- tripId: Dashboard'dan geçirilen gezi ID'si -->
        <argument
            android:name="tripId"
            app:argType="integer"
            android:defaultValue="-1" />

        <action
            android:id="@+id/action_tripDetails_to_editTrip"
            app:destination="@id/editTripFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <!-- ===== AYARLAR FRAGMENT ===== -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.traveler.app.view.fragment.SettingsFragment"
        android:label="Ayarlar"
        tools:layout="@layout/fragment_settings" />


    <fragment
        android:id="@+id/editTripFragment"
        android:name="com.traveler.app.view.fragment.EditTripFragment"
        android:label="Geziyi Düzenle"
        tools:layout="@layout/fragment_edit_trip">
        <argument
            android:name="tripId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>

</navigation>
